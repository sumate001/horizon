# ── LLM inference ────────────────────────────────────────────────────────────
# Shared Ollama server (NVIDIA A5000 over Tailscale). Do NOT deploy a new one.
# Use only models the server already has: gemma4:12b (shared with OSINT//DESK) and bge-m3.
OLLAMA_BASE_URL=http://100.94.37.18:11434
EXTRACT_MODEL=gemma4:12b
EMBED_MODEL=bge-m3
LLM_TIMEOUT=60

# ── Pipeline thresholds ──────────────────────────────────────────────────────
DEDUP_MINHASH_T=0.85
DEDUP_COSINE_T=0.88
DEDUP_WINDOW_DAYS=7
MIN_CLUSTER_SIZE=4
# Distance added per day of separation. Calibrated against the observed cosine
# distance range of bge-m3 on Thai news ([0.13, 0.87]), not the theoretical [0, 2].
TEMPORAL_WEIGHT=0.065
# leaf | eom — eom merges everything into one cluster once a temporal term exists
CLUSTER_SELECTION_METHOD=leaf
CLUSTER_WINDOW_DAYS=30
CLUSTER_MATCH_T=0.9
MAX_CLUSTER_EVENTS=6000
CLUSTER_DORMANT_DAYS=7
WEAK_SIGNAL_T=0.65
TREND_BREAKOUT_T=2.5

# Weak signal combined_score weights (must sum to 1.0)
WEAK_NOVELTY_W=0.4
WEAK_ISOLATION_W=0.3
WEAK_BURST_W=0.3

# Trend score weights (must sum to 1.0)
TREND_ZFREQ_W=0.3
TREND_ZVEL_W=0.4
TREND_ZACCEL_W=0.3

# Fake news gate: sources below this credibility weight are dropped
GATE_MIN_CREDIBILITY=0.2

# ── Reasoner ─────────────────────────────────────────────────────────────────
# Rivals compared against the triggered cluster. LLM cost is quadratic in this:
# n = 1 + AHP_TOP_CLUSTERS gives n(n-1)/2 calls per driving force.
AHP_TOP_CLUSTERS=5
SCENARIO_EVENT_CAP=50
SCENARIO_TREND_WINDOWS=10
SCENARIO_RELATED_CLUSTERS=3
# Do not re-reason about the same cluster more often than this
REASONER_COOLDOWN_HOURS=6

# ── Integration: OSINT//DESK ─────────────────────────────────────────────────
# Leave OSINT_DESK_BASE_URL empty to disable outbound delivery (status=disabled).
OSINT_DESK_BASE_URL=
OSINT_DESK_API_KEY=
# Key that OSINT//DESK must present on POST /api/v1/verdicts
HORIZON_API_KEY=

# ── Alerting ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_NOTIFY_TOKEN=

# ── Infrastructure ───────────────────────────────────────────────────────────
POSTGRES_USER=horizon
POSTGRES_PASSWORD=change_me
POSTGRES_DB=horizon
POSTGRES_URL=postgresql+asyncpg://horizon:change_me@postgres:5432/horizon

REDIS_URL=redis://redis:6379/0
QUEUE_KEY=horizon:articles
SIGNALS_CHANNEL=horizon:signals

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=horizon_events

# Optional SearXNG instance for `type=searxng` sources
SEARXNG_URL=

# ── Runtime ──────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=15
WORKER_CONCURRENCY=2
# Poller stops enqueueing when the queue is deeper than this (backpressure)
QUEUE_MAX_DEPTH=2000
FETCH_TIMEOUT=20
# Pull the full article page when the RSS entry body is shorter than the minimum
FETCH_FULLTEXT=true
FULLTEXT_MIN_CHARS=600
FULLTEXT_CONCURRENCY=5
BATCH_INTERVAL_HOURS=3
DASHBOARD_BASE_URL=http://localhost:8301
LOG_LEVEL=INFO

# ── Observability ────────────────────────────────────────────────────────────
# Each service serves its own /metrics — a shared endpoint would only ever
# report the counters of whichever process happened to answer.
# api is on 8300/metrics; these are the background services.
METRICS_PORT_POLLER=9101
METRICS_PORT_WORKER=9102
METRICS_PORT_BATCH=9103
METRICS_PORT_REASONER=9104
QUEUE_GAUGE_INTERVAL=15
